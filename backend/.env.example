# Database Configuration
DATABASE_URL=sqlite:///./deltafox.db

# Authentication / Security
SESSION_SECRET=super-secret-key-change-this-in-production-min-32-chars
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# Historical Market Data Provider Configuration
HISTORICAL_DATA_PROVIDER=yfinance
HISTORICAL_DATA_API_KEY=

# Dhan Live API Credentials (Optional - if missing, displays 'Data unavailable')
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Admin Initial Credentials
DEFAULT_ADMIN_USER_ID=admin
DEFAULT_ADMIN_PASSWORD=adminpassword123
